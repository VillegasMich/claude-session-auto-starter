# Copy to .env (never commit it) and fill in, or run scripts/init-env.sh. See docs/configuration.md.
# `cargo run` (debug builds) loads ./.env automatically; Docker uses `--env-file .env`.

# Required: long-lived Claude Pro/Max subscription token from `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-xxxxxxxx

# Only start windows inside this range (in TIMEZONE). Unset = all day.
#ACTIVE_HOURS=07:00-23:00
#TIMEZONE=America/Bogota

# auto | oauth-usage | local
#DETECTION=auto
#CHECK_INTERVAL_MINUTES=5

#STARTER_MODEL=haiku
#STARTER_PROMPT=hi

# Defaults to /data (the Docker volume). Set it for local runs; must be outside any git repo,
# e.g. /home/<you>/.local/share/claude-session-starter
#DATA_DIR=/data
#RUST_LOG=info
